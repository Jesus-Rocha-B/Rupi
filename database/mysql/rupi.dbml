Table identidad_cuenta_usuario {
  id CHAR(36) [pk]
  nombre_usuario VARCHAR(80) [not null, unique]
  correo VARCHAR(254) [unique]
  hash_clave VARCHAR(255) [not null]
  estado identidad_cuenta_usuario_estado [not null]
  bloqueado_hasta DATETIME(6)
  clave_cambiada_en DATETIME(6) [not null]
  creado_en DATETIME(6) [not null]
  actualizado_en DATETIME(6) [not null]
  desactivado_en DATETIME(6)
}

Table identidad_perfil_usuario {
  usuario_id CHAR(36) [pk]
  nombre VARCHAR(100)
  apellido VARCHAR(100)
  nombre_preferido VARCHAR(100)
  alias_publico VARCHAR(40)
  mostrar_en_clasificacion BOOLEAN [not null]
  idioma VARCHAR(12) [not null]
  zona_horaria VARCHAR(64) [not null]
  indexes {
    (alias_publico) [unique]
  }
}

Table curriculo_version_catalogo {
  id CHAR(36) [pk]
  etiqueta_version VARCHAR(60) [not null, unique]
  referencia_origen VARCHAR(255)
  vigente_desde DATE
  estado curriculo_version_catalogo_estado [not null]
  creado_en DATETIME(6) [not null]
}

Table curriculo_grado {
  id CHAR(36) [pk]
  numero_grado TINYINT [not null, unique]
  nombre VARCHAR(80) [not null]
}

Table curriculo_area {
  id CHAR(36) [pk]
  version_catalogo_id CHAR(36) [not null]
  codigo VARCHAR(40) [not null]
  nombre VARCHAR(120) [not null]
  indexes {
    (version_catalogo_id, codigo) [unique]
    (id, version_catalogo_id) [unique]
  }
}

Table curriculo_competencia {
  id CHAR(36) [pk]
  area_id CHAR(36) [not null]
  codigo VARCHAR(60) [not null]
  nombre VARCHAR(180) [not null]
  descripcion TEXT
  indexes {
    (area_id, codigo) [unique]
  }
}

Table curriculo_unidad {
  id CHAR(36) [pk]
  version_catalogo_id CHAR(36) [not null]
  grado_id CHAR(36) [not null]
  area_id CHAR(36) [not null]
  codigo VARCHAR(60) [not null]
  titulo VARCHAR(180) [not null]
  numero_secuencia SMALLINT
  indexes {
    (version_catalogo_id, grado_id, area_id, codigo) [unique]
    (id, version_catalogo_id, area_id) [unique]
  }
}

Table curriculo_unidad_competencia {
  unidad_id CHAR(36) [not null]
  competencia_id CHAR(36) [not null]
  indexes {
    (unidad_id, competencia_id) [pk]
  }
}

Table recurso_archivo_multimedia {
  id CHAR(36) [pk]
  creado_por CHAR(36)
  proveedor_almacenamiento VARCHAR(40)
  clave_almacenamiento VARCHAR(500)
  url_externa VARCHAR(1000)
  nombre_original VARCHAR(255) [not null]
  tipo_mime VARCHAR(120) [not null]
  tamano_bytes BIGINT
  hash_sha256 BINARY(32)
  texto_accesibilidad VARCHAR(500)
  creado_en DATETIME(6) [not null]
}

Table aprendizaje_actividad {
  id CHAR(36) [pk]
  tipo aprendizaje_actividad_tipo [not null]
  creado_por CHAR(36)
  creado_en DATETIME(6) [not null]
  archivado_en DATETIME(6)
}

Table aprendizaje_version_actividad {
  id CHAR(36) [pk]
  actividad_id CHAR(36) [not null]
  numero_version INT [not null]
  titulo VARCHAR(180) [not null]
  instrucciones TEXT
  idioma VARCHAR(12) [not null]
  dificultad TINYINT
  minutos_estimados SMALLINT
  estado aprendizaje_version_actividad_estado [not null]
  creado_por CHAR(36)
  creado_en DATETIME(6) [not null]
  publicado_en DATETIME(6)
  indexes {
    (actividad_id, numero_version) [unique]
    (id, actividad_id) [unique]
  }
}

Table aprendizaje_bloque_contenido {
  id CHAR(36) [pk]
  version_actividad_id CHAR(36) [not null]
  numero_secuencia SMALLINT [not null]
  tipo aprendizaje_bloque_contenido_tipo [not null]
  texto_cuerpo TEXT
  archivo_multimedia_id CHAR(36)
  texto_accesibilidad VARCHAR(500)
  indexes {
    (version_actividad_id, numero_secuencia) [unique]
  }
}

Table aprendizaje_actividad_unidad {
  version_actividad_id CHAR(36) [not null]
  unidad_id CHAR(36) [not null]
  indexes {
    (version_actividad_id, unidad_id) [pk]
  }
}

Table aprendizaje_ruta {
  id CHAR(36) [pk]
  propietario_id CHAR(36)
  codigo VARCHAR(40) [unique]
  titulo VARCHAR(180) [not null]
  descripcion TEXT
  creado_en DATETIME(6) [not null]
  actualizado_en DATETIME(6) [not null]
  archivado_en DATETIME(6)
  indexes {
    (titulo, descripcion)
  }
}

Table aprendizaje_version_ruta {
  id CHAR(36) [pk]
  ruta_id CHAR(36) [not null]
  version_catalogo_id CHAR(36) [not null]
  grado_id CHAR(36) [not null]
  area_id CHAR(36) [not null]
  numero_version INT [not null]
  estado aprendizaje_version_ruta_estado [not null]
  creado_por CHAR(36)
  creado_en DATETIME(6) [not null]
  publicado_en DATETIME(6)
  indexes {
    (ruta_id, numero_version) [unique]
    (id, version_catalogo_id, grado_id, area_id) [unique]
  }
}

Table aprendizaje_nodo_ruta {
  id CHAR(36) [pk]
  version_ruta_id CHAR(36) [not null]
  version_actividad_id CHAR(36) [not null]
  unidad_id CHAR(36)
  nodo_prerrequisito_id CHAR(36)
  numero_secuencia SMALLINT [not null]
  mapa_x DECIMAL(5,2)
  mapa_y DECIMAL(5,2)
  es_opcional BOOLEAN [not null]
  indexes {
    (version_ruta_id, numero_secuencia) [unique]
    (version_ruta_id, id) [unique]
    (version_actividad_id)
  }
}

Table aprendizaje_codigo_acceso_ruta {
  id CHAR(36) [pk]
  version_ruta_id CHAR(36) [not null]
  hash_codigo BINARY(32) [not null, unique]
  creado_por CHAR(36)
  valido_desde DATETIME(6) [not null]
  valido_hasta DATETIME(6)
  maximo_usos INT
  revocado_en DATETIME(6)
}

Table aprendizaje_inscripcion_ruta {
  id CHAR(36) [pk]
  version_ruta_id CHAR(36) [not null]
  estudiante_id CHAR(36) [not null]
  codigo_acceso_id CHAR(36)
  estado aprendizaje_inscripcion_ruta_estado [not null]
  ultimo_nodo_visitado_id CHAR(36)
  inscrito_en DATETIME(6) [not null]
  completado_en DATETIME(6)
  indexes {
    (version_ruta_id, estudiante_id) [unique]
    (id, version_ruta_id) [unique]
  }
}

Table aprendizaje_progreso_nodo {
  inscripcion_id CHAR(36) [not null]
  version_ruta_id CHAR(36) [not null]
  nodo_ruta_id CHAR(36) [not null]
  estado aprendizaje_progreso_nodo_estado [not null]
  desbloqueado_en DATETIME(6)
  primer_acceso_en DATETIME(6)
  completado_en DATETIME(6)
  indexes {
    (inscripcion_id, nodo_ruta_id) [pk]
  }
}

Table identidad_rol {
  id CHAR(36) [pk]
  codigo VARCHAR(40) [not null, unique]
  nombre VARCHAR(100) [not null]
  descripcion VARCHAR(255)
}

Table identidad_permiso {
  id CHAR(36) [pk]
  codigo VARCHAR(80) [not null, unique]
  descripcion VARCHAR(255)
}

Table identidad_usuario_rol {
  usuario_id CHAR(36) [not null]
  rol_id CHAR(36) [not null]
  asignado_por CHAR(36)
  asignado_en DATETIME(6) [not null]
  indexes {
    (usuario_id, rol_id) [pk]
  }
}

Table identidad_rol_permiso {
  rol_id CHAR(36) [not null]
  permiso_id CHAR(36) [not null]
  indexes {
    (rol_id, permiso_id) [pk]
  }
}

Table identidad_sesion_usuario {
  id CHAR(36) [pk]
  usuario_id CHAR(36) [not null]
  token_hash BINARY(32) [not null, unique]
  revocada_en DATETIME(6)
  usuario_activo_id CHAR(36)
  cliente identidad_sesion_usuario_cliente [not null]
  creada_en DATETIME(6) [not null]
  actividad_en DATETIME(6) [not null]
  expira_en DATETIME(6) [not null]
  indexes {
    (usuario_activo_id) [unique]
    (usuario_id, expira_en)
  }
}

Table identidad_dispositivo {
  id CHAR(36) [pk]
  usuario_id CHAR(36) [not null]
  plataforma identidad_dispositivo_plataforma [not null]
  hash_instalacion BINARY(32) [not null]
  version_aplicacion VARCHAR(40)
  registrado_en DATETIME(6) [not null]
  ultimo_acceso_en DATETIME(6)
  revocado_en DATETIME(6)
  indexes {
    (usuario_id, hash_instalacion) [unique]
    (id, usuario_id) [unique]
  }
}

Table identidad_intento_acceso {
  id BIGINT [pk]
  usuario_id CHAR(36)
  identificador_hash BINARY(32) [not null]
  resultado identidad_intento_acceso_resultado [not null]
  origen_hash BINARY(32)
  ocurrido_en DATETIME(6) [not null]
  indexes {
    (identificador_hash, ocurrido_en)
    (usuario_id, ocurrido_en)
  }
}

Table identidad_factor_mfa {
  id CHAR(36) [pk]
  usuario_id CHAR(36) [not null]
  tipo identidad_factor_mfa_tipo [not null]
  secreto_cifrado VARBINARY(1024)
  referencia_clave VARCHAR(255)
  destino_enmascarado VARCHAR(120)
  verificado_en DATETIME(6)
  creado_en DATETIME(6) [not null]
  desactivado_en DATETIME(6)
  indexes {
    (usuario_id, desactivado_en)
  }
}

Table identidad_codigo_recuperacion {
  id CHAR(36) [pk]
  factor_mfa_id CHAR(36) [not null]
  codigo_hash BINARY(32) [not null]
  creado_en DATETIME(6) [not null]
  usado_en DATETIME(6)
  indexes {
    (factor_mfa_id, codigo_hash) [unique]
  }
}

Table identidad_token_restablecer_clave {
  id CHAR(36) [pk]
  usuario_id CHAR(36) [not null]
  token_hash BINARY(32) [not null, unique]
  creado_en DATETIME(6) [not null]
  expira_en DATETIME(6) [not null]
  usado_en DATETIME(6)
}

Table escuela_institucion {
  id CHAR(36) [pk]
  codigo VARCHAR(40) [unique]
  nombre VARCHAR(180) [not null]
  nivel escuela_institucion_nivel [not null]
  ubigeo CHAR(6)
  activa BOOLEAN [not null]
  creado_en DATETIME(6) [not null]
}

Table escuela_anio_escolar {
  id CHAR(36) [pk]
  institucion_id CHAR(36) [not null]
  anio SMALLINT [not null]
  comienza DATE
  termina DATE
  estado escuela_anio_escolar_estado [not null]
  indexes {
    (id, institucion_id) [unique]
    (institucion_id, anio) [unique]
  }
}

Table escuela_aula {
  id CHAR(36) [pk]
  institucion_id CHAR(36) [not null]
  anio_escolar_id CHAR(36) [not null]
  grado_id CHAR(36) [not null]
  codigo VARCHAR(40) [not null]
  nombre VARCHAR(120) [not null]
  docente_responsable_id CHAR(36)
  activa BOOLEAN [not null]
  indexes {
    (anio_escolar_id, codigo) [unique]
    (id, institucion_id) [unique]
  }
}

Table escuela_membresia_aula {
  id CHAR(36) [pk]
  aula_id CHAR(36) [not null]
  usuario_id CHAR(36) [not null]
  rol escuela_membresia_aula_rol [not null]
  estado escuela_membresia_aula_estado [not null]
  ingreso_en DATETIME(6) [not null]
  retiro_en DATETIME(6)
  indexes {
    (aula_id, usuario_id) [unique]
    (id, aula_id) [unique]
  }
}

Table escuela_consentimiento_tutor {
  id CHAR(36) [pk]
  estudiante_id CHAR(36) [not null]
  tutor_usuario_id CHAR(36)
  relacion VARCHAR(40)
  correo_tutor_cifrado VARBINARY(512)
  referencia_clave VARCHAR(255)
  proposito escuela_consentimiento_tutor_proposito [not null]
  version_aviso VARCHAR(40) [not null]
  metodo_verificacion escuela_consentimiento_tutor_metodo_verificacion
  evidencia_referencia VARCHAR(255)
  estado escuela_consentimiento_tutor_estado [not null]
  registrado_en DATETIME(6) [not null]
  revocado_en DATETIME(6)
}

Table escuela_periodo_academico {
  id CHAR(36) [pk]
  anio_escolar_id CHAR(36) [not null]
  tipo escuela_periodo_academico_tipo [not null]
  numero TINYINT [not null]
  nombre VARCHAR(80) [not null]
  comienza DATE [not null]
  termina DATE [not null]
  indexes {
    (anio_escolar_id, tipo, numero) [unique]
  }
}

Table curriculo_meta_aprendizaje {
  id CHAR(36) [pk]
  competencia_id CHAR(36) [not null]
  grado_id CHAR(36) [not null]
  codigo VARCHAR(60) [not null]
  descripcion TEXT [not null]
  indexes {
    (competencia_id, grado_id, codigo) [unique]
  }
}

Table curriculo_unidad_meta {
  unidad_id CHAR(36) [not null]
  meta_id CHAR(36) [not null]
  indexes {
    (unidad_id, meta_id) [pk]
  }
}

Table curriculo_estandar {
  id CHAR(36) [pk]
  competencia_id CHAR(36) [not null]
  grado_id CHAR(36)
  codigo VARCHAR(60) [not null]
  descripcion TEXT [not null]
  indexes {
    (competencia_id, codigo) [unique]
  }
}

Table curriculo_unidad_estandar {
  unidad_id CHAR(36) [not null]
  estandar_id CHAR(36) [not null]
  indexes {
    (unidad_id, estandar_id) [pk]
  }
}

Table aprendizaje_sesion_estudio {
  id CHAR(36) [pk]
  usuario_id CHAR(36) [not null]
  inscripcion_id CHAR(36)
  nodo_ruta_id CHAR(36)
  inicio_en DATETIME(6) [not null]
  fin_en DATETIME(6)
  origen aprendizaje_sesion_estudio_origen [not null]
  cliente_evento_id CHAR(36) [not null]
  indexes {
    (usuario_id, cliente_evento_id) [unique]
    (usuario_id, inicio_en)
  }
}

Table escuela_evento_calendario {
  id CHAR(36) [pk]
  aula_id CHAR(36) [not null]
  creado_por CHAR(36) [not null]
  titulo VARCHAR(180) [not null]
  descripcion TEXT
  tipo escuela_evento_calendario_tipo [not null]
  inicia_en DATETIME(6) [not null]
  termina_en DATETIME(6)
  creado_en DATETIME(6) [not null]
}

Table aprendizaje_tarea {
  id CHAR(36) [pk]
  actividad_version_id CHAR(36) [not null]
  asignada_por CHAR(36) [not null]
  titulo VARCHAR(180) [not null]
  instrucciones TEXT
  creada_en DATETIME(6) [not null]
}

Table aprendizaje_entrega_tarea {
